{% extends 'base.html.twig' %}
{% block title %}Mot de passe oublié{% endblock %}
{% block body %}
<div class="card auth-card shadow-sm"><div class="card-body p-4">
    <h1 class="h3">Mot de passe oublié</h1>
    <p>Indiquez votre adresse email pour recevoir un lien de réinitialisation.</p>
    {{ form_start(form) }}{{ form_widget(form) }}
        <button class="btn btn-primary">Envoyer le lien</button>
    {{ form_end(form) }}
    <a class="d-inline-block mt-3" href="{{ path('app_login') }}">Retour à la connexion</a>
</div></div>
{% endblock %}

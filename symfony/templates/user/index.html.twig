{% extends 'base.html.twig' %}
{% block title %}Utilisateurs{% endblock %}
{% block body %}
<div class="page-heading">
    <div><p class="eyebrow">VOTRE ÉQUIPE</p><h1>Utilisateurs</h1><p class="page-description">Retrouvez et gérez les comptes de votre espace de travail.</p></div>
    {% if is_granted('ROLE_ADMIN') %}<a class="btn btn-primary" href="{{ path('app_user_new') }}"><i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Ajouter un utilisateur</a>{% endif %}
</div>
<div class="card filter-panel"><form method="get" action="{{ path('app_user_index') }}" class="row g-3 align-items-end">
    {% for field, label in {email: 'Email', nom: 'Nom', prenom: 'Prénom'} %}
        <div class="col-sm-6 col-lg-3">
            <label class="form-label" for="filter-{{ field }}">{{ label }}</label>
            <input id="filter-{{ field }}" name="{{ field }}" class="form-control" value="{{ app.request.query.get(field) }}">
        </div>
    {% endfor %}
    <div class="col-sm-6 col-lg-3 d-flex gap-2">
        <button class="btn btn-primary">Rechercher</button>
        <a class="btn btn-outline-secondary" href="{{ path('app_user_index') }}" aria-label="Effacer les filtres">Effacer</a>
    </div>
</form></div>
<div class="card overflow-hidden"><div class="table-responsive">
<table class="table directory-table table-hover align-middle mb-0">
    <caption class="visually-hidden">Annuaire des utilisateurs, avec leur rôle et l’état du compte.</caption>
    <thead><tr>
        <th scope="col">{{ knp_pagination_sortable(pagination, 'Email', 'u.email') }}</th>
        <th scope="col">{{ knp_pagination_sortable(pagination, 'Nom', 'u.nom') }}</th>
        <th scope="col">{{ knp_pagination_sortable(pagination, 'Prénom', 'u.prenom') }}</th>
        <th scope="col">Rôle</th><th scope="col">État</th><th scope="col">Actions</th>
    </tr></thead>
    <tbody>
    {% for user in pagination %}
        <tr>
            <td class="user-email">{{ user.email }}</td><td class="user-name">{{ user.nom }}</td><td>{{ user.prenom }}</td>
            <td><span class="role-badge {{ 'ROLE_ADMIN' in user.roles ? 'admin' : '' }}">{{ 'ROLE_ADMIN' in user.roles ? 'Administrateur' : 'Utilisateur' }}</span></td>
            <td><span class="status-badge {{ user.active ? '' : 'inactive' }}">{{ user.active ? 'Actif' : 'Désactivé' }}</span></td>
            <td><div class="d-flex flex-wrap gap-2">
                <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_user_show', {id: user.id}) }}" aria-label="Voir {{ user.email }}">Voir</a>
                {% if is_granted('ROLE_ADMIN') %}
                    <a class="btn btn-sm btn-outline-primary" href="{{ path('app_user_edit', {id: user.id}) }}" aria-label="Modifier {{ user.email }}">Modifier</a>
                    {{ include('user/_delete_form.html.twig') }}
                {% endif %}
            </div></td>
        </tr>
    {% else %}
        <tr><td colspan="6" class="text-center py-4">Aucun utilisateur trouvé.</td></tr>
    {% endfor %}
    </tbody>
</table>
</div></div>
<div class="d-flex justify-content-center mt-4">{{ knp_pagination_render(pagination) }}</div>
{% endblock %}

<form method="post" action="{{ path('app_user_delete', {id: user.id}) }}" data-controller="confirm" data-action="submit->confirm#submit" data-confirm-message-value="Supprimer ce compte définitivement ?">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
    <button class="btn btn-sm btn-outline-danger" aria-label="Supprimer {{ user.email }}">Supprimer</button>
</form>

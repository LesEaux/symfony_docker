{% extends 'base.html.twig' %}
{% block title %}Changer mon mot de passe{% endblock %}
{% block body %}
<div class="card form-card shadow-sm"><div class="card-body p-4">
    <h1 class="h3 mb-3">Changer mon mot de passe</h1>
    <p>Choisissez un mot de passe de 12 caractères minimum.</p>
    {{ form_start(form) }}{{ form_widget(form) }}
        <button class="btn btn-primary">Modifier le mot de passe</button>
    {{ form_end(form) }}
</div></div>
{% endblock %}

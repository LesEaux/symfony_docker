{% set current_theme = app.user ? app.user.theme : 'dark' %}
<!DOCTYPE html>
<html lang="fr" data-bs-theme="{{ current_theme }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ current_theme == 'dark' ? '#101d30' : '#ffffff' }}">
    <meta name="color-scheme" content="{{ current_theme }}">
    <title>{% block title %}Accueil{% endblock %} · {{ app_name }}</title>
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('bootstrap/css/bootstrap.min.css') }}">
        <link rel="stylesheet" href="{{ asset('bootstrap-icons/bootstrap-icons.min.css') }}">
    {% endblock %}
    {% block javascripts %}
        <script src="{{ asset('bootstrap/js/bootstrap.bundle.min.js') }}" defer></script>
        {{ importmap('app') }}
    {% endblock %}
</head>
<body data-controller="menu theme" data-theme-current-value="{{ current_theme }}" data-action="keydown.esc@window->menu#close turbo:before-cache@document->menu#close">
<a class="visually-hidden-focusable skip-link" href="#main-content">Aller au contenu</a>
<div class="menu-backdrop" data-menu-target="backdrop" data-action="click->menu#close" hidden></div>
<aside id="main-menu" class="sidebar" aria-label="Navigation principale" data-menu-target="panel">
    <div class="sidebar-brand">
        <a class="brand" href="{{ path('home') }}">
            <svg class="brand-mark" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M3 6h9l9 19-5 10L3 6Z" fill="currentColor"/><path d="M27 6h10L23 35h-7L27 6Z" fill="currentColor" opacity=".65"/></svg>
            <span>{{ app_name }}</span>
        </a>
        <button class="btn icon-button d-lg-none" type="button" data-action="menu#close" aria-label="Fermer le menu"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
    <div class="navigation-label">ESPACE DE TRAVAIL</div>
    {% set route = app.request.attributes.get('_route')|default('') %}
    <nav class="nav flex-column sidebar-nav">
        <a class="nav-link {{ route == 'home' ? 'active' : '' }}" href="{{ path('home') }}" {% if route == 'home' %}aria-current="page"{% endif %}>
            <i class="bi bi-grid-1x2-fill" aria-hidden="true"></i><span>Accueil</span>
        </a>
        {% if is_granted('ROLE_USER') %}
            <a class="nav-link {{ route starts with 'app_user_' ? 'active' : '' }}" href="{{ path('app_user_index') }}" {% if route starts with 'app_user_' %}aria-current="page"{% endif %}>
                <i class="bi bi-people" aria-hidden="true"></i><span>Utilisateurs</span>
            </a>
            <a class="nav-link {{ route starts with 'app_profile' ? 'active' : '' }}" href="{{ path('app_profile') }}" {% if route starts with 'app_profile' %}aria-current="page"{% endif %}>
                <i class="bi bi-person-circle" aria-hidden="true"></i><span>Mon profil</span>
            </a>
        {% endif %}
    </nav>
    <div class="sidebar-footer">
        <span class="company-icon"><i class="bi bi-buildings" aria-hidden="true"></i></span>
        <div class="min-width-0"><span class="company-name">{{ app_company }}</span><span class="company-caption">Votre espace, simplement.</span></div>
    </div>
</aside>
<div class="content-wrapper">
    <header class="topbar">
        <div class="d-flex align-items-center gap-3 min-width-0">
            <button type="button" class="btn icon-button d-lg-none" aria-label="Ouvrir le menu" aria-controls="main-menu" aria-expanded="false" data-menu-target="toggle" data-action="menu#open"><i class="bi bi-list" aria-hidden="true"></i></button>
            <span class="topbar-company-icon d-none d-sm-inline-flex"><i class="bi bi-buildings" aria-hidden="true"></i></span>
            <span class="topbar-company text-truncate">{{ app_company }}</span>
        </div>
        {% if app.user %}
            <div class="dropdown">
                <button class="account-button dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="Menu du compte">
                    <span class="avatar avatar-teal">{{ app.user.prenom|slice(0, 1)|upper }}</span>
                    <span class="account-details d-none d-sm-flex"><span class="account-name">{{ app.user.prenom }}</span><span class="account-role">{{ is_granted('ROLE_ADMIN') ? 'Administrateur' : 'Utilisateur' }}</span></span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="{{ path('app_profile') }}"><i class="bi bi-person me-2" aria-hidden="true"></i>Mon profil</a></li>
                    <li><a class="dropdown-item" href="{{ path('app_profile_password') }}"><i class="bi bi-key me-2" aria-hidden="true"></i>Changer mon mot de passe</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li class="theme-menu-row"><span>Apparence</span>{{ include('profile/_theme_toggle.html.twig') }}</li>
                    <li class="theme-menu-status" data-theme-target="status"></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><form action="{{ path('app_logout') }}" method="post" data-turbo="false"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="dropdown-item"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Déconnexion</button></form></li>
                </ul>
            </div>
        {% else %}
            <a class="btn btn-primary btn-sm" href="{{ path('app_login') }}">Connexion<i class="bi bi-arrow-right ms-2" aria-hidden="true"></i></a>
        {% endif %}
    </header>
    <main id="main-content" class="main-content" tabindex="-1">
        <div class="page-shell">
            <p class="visually-hidden" role="status" aria-live="polite" data-theme-target="status"></p>
            {% for type, messages in app.flashes %}
                {% for message in messages %}<div class="alert alert-{{ type }}" role="{{ type == 'danger' ? 'alert' : 'status' }}">{{ message }}</div>{% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </div>
    </main>
</div>
</body>
</html>

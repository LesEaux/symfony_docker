APP_SECRET=replace-with-a-random-secret
APP_NAME=VodableWeb
APP_COMPANY='Mon entreprise'
APP_URL=https://app.example.com
MYSQL_PASSWORD=replace-with-a-long-alphanumeric-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-alphanumeric-password
DATABASE_URL=mysql://app:replace-with-a-long-alphanumeric-password@db:3306/app?serverVersion=8.4.0&charset=utf8mb4
MAILER_DSN=smtp://user:password@smtp.example.com:587
MAILER_FROM=no-reply@example.com
HTTP_PORT=8088
# Exact IP/CIDR of the reverse proxy as seen by PHP; adapt to the hosting network.
TRUSTED_PROXIES=127.0.0.1
